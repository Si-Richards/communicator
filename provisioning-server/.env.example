PROVISIONING_DATABASE=/data/provisioning.db
PROVISIONING_ADMIN_KEY=change-me
PROVISIONING_RANDY_URL=https://randy.voicehost.io
PROVISIONING_JANUS_URL=wss://devrtc.voicehost.io:443
ACCESS_TOKEN_TTL_SECONDS=900
ACTIVATION_TTL_SECONDS=900
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Set a persistent random key; changing it disables retries for rotations made with the old key.
PROVISIONING_REFRESH_RETRY_KEY=
REFRESH_RETRY_GRACE_SECONDS=30
