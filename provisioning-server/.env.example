PROVISIONING_DATABASE=/data/provisioning.db
PROVISIONING_ADMIN_KEY=change-me
PROVISIONING_RANDY_URL=https://randy.voicehost.io
PROVISIONING_JANUS_URL=wss://devrtc.voicehost.io:443
ACCESS_TOKEN_TTL_SECONDS=900
ACTIVATION_TTL_SECONDS=900
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Set a persistent random key; changing it disables retries for rotations made with the old key.
PROVISIONING_REFRESH_RETRY_KEY=
REFRESH_RETRY_GRACE_SECONDS=86400

# Admin portal: generate these locally; never commit their real values.
PROVISIONING_PORTAL_SECRET=
PROVISIONING_PORTAL_PASSWORD_HASH=
PROVISIONING_PORTAL_ORIGIN=https://provisioning.softphone.voicehost.io:8443

# Optional automatic account lifecycle (ejabberd >=25.08, API v2).
# The private HTTPS API must be reachable only from provisioning infrastructure.
EJABBERD_MANAGEMENT_ENABLED=false
EJABBERD_HOST=ejabberd.voicehost.io
EJABBERD_WEBSOCKET=wss://ejabberd.voicehost.io/websocket
EJABBERD_API_URL=
EJABBERD_API_USERNAME=
EJABBERD_API_PASSWORD=
