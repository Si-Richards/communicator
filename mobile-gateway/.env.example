GATEWAY_API_KEY=replace-with-a-long-random-value
DEVICE_DATA_KEY=generate-with-python-fernet
DATABASE_PATH=/data/mobile-gateway.db

# Public HTTPS hostname handled by the NGINX container.
GATEWAY_HOSTNAME=randy.voicehost.io

JANUS_URL=wss://devrtc.voicehost.io:443
JANUS_API_SECRET=
# One helper plus the master gives the handset an active call + one waiting call.
JANUS_HELPER_COUNT=1

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=uk.co.voicehost.communicator.dev
APNS_KEY_PATH=/run/secrets/AuthKey.p8
APNS_SANDBOX=true
